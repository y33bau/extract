; Warownia Popiołów (Godot 4.7)
config_version=5

[application]
config/name="Warownia Popiolow"
run/main_scene="res://gra.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Sterowanie="*res://skrypty/sterowanie.gd"
Dane="*res://skrypty/dane.gd"
Profil="*res://skrypty/profil.gd"
Swiatla="*res://skrypty/swiatla.gd"
Dzwiek="*res://skrypty/dzwiek.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/glow/upscale_mode=1
textures/default_filters/anisotropic_filtering_level=4
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.04, 1)
